# 32 random bytes, base64: head -c 32 /dev/urandom | base64
ZULU_KEY_ENCRYPTION_KEY=

# Log pushes instead of sending them, for running without an Apple account.
ZULU_APNS_DRY_RUN=true

# APNs token auth. Put the .p8 in ./secrets/ and point at the mounted path.
ZULU_APNS_KEY_FILE=/run/secrets/apns.p8
ZULU_APNS_KEY_ID=
ZULU_APNS_TEAM_ID=
ZULU_APNS_BUNDLE_ID=com.bwees.zulu
